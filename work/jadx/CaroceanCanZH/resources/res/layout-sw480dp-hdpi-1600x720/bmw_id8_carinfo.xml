<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bmw_id8_orange_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.can.ui.view.ID8SpeedMeter
        android:id="@+id/carinfo_speedmeter"
        android:layout_width="262dp"
        android:layout_height="378dp"
        android:layout_marginTop="82dp"
        android:layout_marginStart="174dp"
        app:meterType="0"/>
    <com.can.ui.view.ID8SpeedMeter
        android:id="@+id/carinfo_rpmmeter"
        android:layout_width="262dp"
        android:layout_height="380dp"
        android:layout_marginTop="80dp"
        android:layout_marginStart="630dp"
        app:meterType="1"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/carinfo_safeb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:src="@drawable/bmw_id8_carinfo_safeb"
        android:layout_marginEnd="30dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/carinfo_handbrake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="61dp"
        android:src="@drawable/bmw_id8_carinfo_handbreak"
        android:layout_marginEnd="95dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/carinfo_bigled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="66dp"
        android:src="@drawable/bmw_id8_carinfo_bigled_nor"
        android:layout_marginEnd="155dp"/>
    <ImageView
        android:id="@+id/carinfo_footbrake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:src="@drawable/carinfo_footbreak"
        android:layout_marginStart="555dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/carinfo_gear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="340dp"
        android:src="@drawable/bmw_id8_carinfo_gear_p"/>
    <LinearLayout
        android:gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="402dp"
        android:layout_marginStart="45dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bmw_id8_carinfo_gas"/>
        <TextView
            android:textSize="26sp"
            android:textColor="@color/white"
            android:id="@+id/carinfo_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
    <TextView
        android:textSize="30sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/carinfo_mileage"
        android:layout_width="145dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="395dp"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/carinfo_outtemp"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="402dp"
        android:layout_marginEnd="45dp"/>
    <ImageView
        android:id="@+id/carinfo_leftl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:src="@drawable/carinfo_leftl"
        android:layout_marginStart="420dp"/>
    <ImageView
        android:id="@+id/carinfo_rightl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:src="@drawable/carinfo_rightl"
        android:layout_marginStart="610dp"/>
    <TextView
        android:textSize="88sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/carinfo_rate_text"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="165dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#9ea1a2"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/carinfo_rate_unit"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="285dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#9ea1a2"
        android:gravity="center"
        android:id="@+id/carinfo_rate_unit1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:layout_marginStart="325dp"/>
</FrameLayout>
