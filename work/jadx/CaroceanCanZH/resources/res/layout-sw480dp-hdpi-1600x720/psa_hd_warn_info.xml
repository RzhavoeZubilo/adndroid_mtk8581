<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/can_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/fuel_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/tx_curfuel_size"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/str_psa_warn_info"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/tx_curfuel_size"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/psa_hd_tv_warn_num_type"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/str_psa_rear_wiper"
            android:layout_weight="1"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
