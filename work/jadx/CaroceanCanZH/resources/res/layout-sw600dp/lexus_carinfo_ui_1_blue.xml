<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:speedometer="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/lexus_drive_eco_bg"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.can.ui.view.MarqueeTextView
        android:textSize="32sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:layout_gravity="top|left"
        android:visibility="gone"
        android:layout_width="400dp"
        android:layout_height="59dp"
        android:layout_marginLeft="130dp"
        android:text="@string/app_name_new_carinfo"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <com.can.ui.view.Speedometer
        android:layout_gravity="center_vertical"
        android:id="@+id/carinfo_rate"
        android:visibility="gone"
        android:layout_width="389dp"
        android:layout_height="389dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="153dp"
        speedometer:mode="0"
        speedometer:pointer="@drawable/drive_eco_spointer"
        speedometer:rotate_max="260"
        speedometer:value_max="240"/>
    <TextView
        android:textSize="76sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/carinfo_rate_text"
        android:layout_width="170dp"
        android:layout_height="100dp"
        android:layout_marginTop="140dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/carinfo_rate_unit"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="230dp"
        android:text="km/h"/>
    <com.can.ui.view.Speedometer
        android:layout_gravity="center_horizontal"
        android:id="@+id/carinfo_rpm"
        android:layout_width="429dp"
        android:layout_height="429dp"
        android:layout_marginTop="19dp"
        android:layout_marginStart="0dp"
        speedometer:mode="0"
        speedometer:pointer="@drawable/lexus_drive_eco_tpointer"
        speedometer:rotate_max="241"
        speedometer:value_max="8000"/>
    <ImageView
        android:id="@+id/carinfo_safeb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="360dp"
        android:src="@drawable/lexus_carinfo_safeb"
        android:layout_marginStart="810dp"/>
    <ImageView
        android:id="@+id/carinfo_handbrake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="355dp"
        android:src="@drawable/lexus_carinfo_handbreak"
        android:layout_marginStart="860dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/carinfo_gear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="290dp"
        android:src="@drawable/lexus_carinfo_gear_p"/>
    <LinearLayout
        android:gravity="left"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="847dp"
        android:layout_marginTop="347dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/carinfo_gas"/>
        <TextView
            android:textSize="26sp"
            android:textColor="@color/white"
            android:id="@+id/carinfo_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="26sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/carinfo_outtemp"
        android:layout_width="204dp"
        android:layout_height="29dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="80dp"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/carinfo_mileage"
        android:layout_width="204dp"
        android:layout_height="29dp"
        android:layout_marginTop="360dp"
        android:layout_marginStart="80dp"/>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:layout_width="400dp"
        android:layout_height="38dp"
        android:layout_marginTop="36dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/carinfo_leftl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/carinfo_leftl"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/carinfo_rightl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/carinfo_rightl"/>
    </FrameLayout>
    <include
        android:layout_width="165dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:layout_marginStart="90dp"
        layout="@layout/lexus_door"/>
</FrameLayout>
