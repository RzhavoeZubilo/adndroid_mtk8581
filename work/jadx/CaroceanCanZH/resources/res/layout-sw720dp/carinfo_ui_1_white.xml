<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:speedometer="http://schemas.android.com/apk/res/com.can.activity"
    android:background="@drawable/drive_comfort_bg"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.can.ui.view.MarqueeTextView
        android:textSize="42sp"
        android:textColor="@color/white"
        android:ellipsize="marquee"
        android:gravity="center"
        android:layout_gravity="top|left"
        android:layout_width="wrap_content"
        android:layout_height="82dp"
        android:layout_marginLeft="200dp"
        android:text="@string/app_name_new_carinfo"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"/>
    <com.can.ui.view.Speedometer
        android:id="@+id/carinfo_rate"
        android:layout_width="621dp"
        android:layout_height="621dp"
        android:layout_marginLeft="208dp"
        android:layout_marginTop="61dp"
        speedometer:mode="1"
        speedometer:pointer="@drawable/drive_comfort_spointer"/>
    <TextView
        android:textSize="26sp"
        android:textColor="@color/white"
        android:id="@+id/carinfo_rate_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="300dp"
        android:layout_marginTop="400dp"/>
    <com.can.ui.view.Speedometer
        android:id="@+id/carinfo_rpm"
        android:layout_width="621dp"
        android:layout_height="621dp"
        android:layout_marginLeft="1087dp"
        android:layout_marginTop="61dp"
        speedometer:mode="1"
        speedometer:pointer="@drawable/drive_comfort_tpointer"/>
    <ImageView
        android:id="@+id/carinfo_bigled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="232dp"
        android:layout_marginTop="88dp"
        android:src="@drawable/carinfo_bigled_nor"/>
    <ImageView
        android:id="@+id/carinfo_safeb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="232dp"
        android:layout_marginTop="608dp"
        android:src="@drawable/carinfo_safeb"/>
    <ImageView
        android:id="@+id/carinfo_handbrake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1624dp"
        android:layout_marginTop="88dp"
        android:src="@drawable/carinfo_handbreak"/>
    <ImageView
        android:id="@+id/carinfo_footbrake"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1624dp"
        android:layout_marginTop="608dp"
        android:src="@drawable/carinfo_footbreak"/>
    <ImageView
        android:id="@+id/carinfo_gear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="608dp"
        android:layout_marginTop="515dp"
        android:src="@drawable/carinfo_gear_p"/>
    <LinearLayout
        android:gravity="left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="1254dp"
        android:layout_marginTop="515dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/carinfo_gas"/>
        <TextView
            android:textSize="42sp"
            android:textColor="@color/white"
            android:layout_gravity="bottom"
            android:id="@+id/carinfo_gps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:layout_width="480dp"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:textSize="42sp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/carinfo_mileage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/carinfo_leftl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/carinfo_leftl"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/carinfo_rightl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/carinfo_rightl"/>
    </FrameLayout>
</FrameLayout>
