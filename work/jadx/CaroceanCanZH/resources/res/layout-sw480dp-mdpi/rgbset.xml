<?xml version="1.0" encoding="utf-8"?>
<com.can.ui.draw.Rgb xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/dialog_set_bk"
        android:layout_width="588px"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/textsize_general1"
            android:textColor="@color/white"
            android:gravity="left"
            android:id="@+id/text_title"
            android:paddingLeft="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/factory_rgb_set"/>
        <Button
            android:textSize="@dimen/textsize_general1"
            android:textColor="@color/white"
            android:id="@+id/rgb_reset_close"
            android:background="@drawable/btn_rgb_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/close"
            android:layout_alignParentRight="true"/>
        <Button
            android:textSize="@dimen/textsize_general1"
            android:textColor="@color/white"
            android:id="@+id/rgb_reset_all"
            android:background="@drawable/btn_rgb_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/light_reset_bt"
            android:layout_toLeftOf="@+id/rgb_reset_close"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/text_title">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_video_bright_state"/>
                <SeekBar
                    android:id="@+id/seekBar_brightness"
                    android:layout_width="@dimen/dialog_seekbar_width"
                    android:layout_height="@dimen/dialog_seekbar_height"
                    android:layout_marginLeft="20dp"
                    android:maxHeight="@dimen/dialog_seekbar_height"
                    android:max="255"
                    android:progressDrawable="@drawable/seekbar_dialog_style"
                    android:minHeight="@dimen/dialog_seekbar_height"
                    android:thumb="@drawable/selector_seekbar_yuv_point_state"
                    android:thumbOffset="0px"/>
                <TextView
                    android:textSize="@dimen/textsize_general"
                    android:textColor="@android:color/white"
                    android:gravity="left"
                    android:id="@+id/text_bright_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_video_contrast_state"/>
                <SeekBar
                    android:id="@+id/seekBar_contrast"
                    android:layout_width="@dimen/dialog_seekbar_width"
                    android:layout_height="@dimen/dialog_seekbar_height"
                    android:layout_marginLeft="20dp"
                    android:maxHeight="@dimen/dialog_seekbar_height"
                    android:max="255"
                    android:progressDrawable="@drawable/seekbar_dialog_style"
                    android:minHeight="@dimen/dialog_seekbar_height"
                    android:thumb="@drawable/selector_seekbar_yuv_point_state"
                    android:thumbOffset="0px"/>
                <TextView
                    android:textSize="@dimen/textsize_general"
                    android:textColor="@android:color/white"
                    android:gravity="left"
                    android:id="@+id/text_contrast_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_video_hue_state"/>
                <SeekBar
                    android:id="@+id/seekBar_hue"
                    android:layout_width="@dimen/dialog_seekbar_width"
                    android:layout_height="@dimen/dialog_seekbar_height"
                    android:layout_marginLeft="20dp"
                    android:maxHeight="@dimen/dialog_seekbar_height"
                    android:max="63"
                    android:progressDrawable="@drawable/seekbar_dialog_style"
                    android:minHeight="@dimen/dialog_seekbar_height"
                    android:thumb="@drawable/selector_seekbar_yuv_point_state"
                    android:thumbOffset="0px"/>
                <TextView
                    android:textSize="@dimen/textsize_general"
                    android:textColor="@android:color/white"
                    android:gravity="left"
                    android:id="@+id/text_hue_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_video_saturation_state"/>
                <SeekBar
                    android:id="@+id/seekBar_saturation"
                    android:layout_width="@dimen/dialog_seekbar_width"
                    android:layout_height="@dimen/dialog_seekbar_height"
                    android:layout_marginLeft="20dp"
                    android:maxHeight="@dimen/dialog_seekbar_height"
                    android:max="255"
                    android:progressDrawable="@drawable/seekbar_dialog_style"
                    android:minHeight="@dimen/dialog_seekbar_height"
                    android:thumb="@drawable/selector_seekbar_yuv_point_state"
                    android:thumbOffset="0px"/>
                <TextView
                    android:textSize="@dimen/textsize_general"
                    android:textColor="@android:color/white"
                    android:gravity="left"
                    android:id="@+id/text_saturation_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.can.ui.draw.Rgb>
