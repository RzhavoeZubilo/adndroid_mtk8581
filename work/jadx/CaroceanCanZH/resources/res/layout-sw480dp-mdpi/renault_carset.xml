                android:text="@string/str_renault_carset_parking_front"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_renault_carset_parking_front"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_parking_rear"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_renault_carset_parking_rear"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_takecare"
                style="@style/car_info_style1"/>
