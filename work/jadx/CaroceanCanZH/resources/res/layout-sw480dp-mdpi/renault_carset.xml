                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_userset_external"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_renault_carset_userset_external"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_userset_drivinglock"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_renault_carset_userset_drivinglock"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
