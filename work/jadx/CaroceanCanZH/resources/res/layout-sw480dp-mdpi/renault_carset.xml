            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_userset_lang"
                style="@style/car_info_style"/>
            <TextView style="@style/car_set_right_style1"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/btn_renault_carset_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_reset"
                style="@style/car_info_style"/>
            <TextView style="@style/car_set_right_style2"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
