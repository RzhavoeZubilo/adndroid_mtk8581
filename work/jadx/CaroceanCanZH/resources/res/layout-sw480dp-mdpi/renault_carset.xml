                android:id="@+id/checkbox_renault_carset_takecare_fresh"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_renault_carset_takecare_autostart"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_renault_carset_takecare_autostart"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_renault_carset_takecare_generator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
