<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/can_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/fuel_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dps_psa_margintop">
            <TextView
                android:textSize="@dimen/tx_curfuel_size"
                android:textColor="@android:color/white"
                android:id="@+id/psa_tv_warn_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dps_psa_marginleft"/>
            <TextView
                android:textSize="@dimen/tx_curfuel_size"
                android:textColor="@android:color/white"
                android:id="@+id/psa_tv_warn_num_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dps_psa_marginleft"/>
            <TextView
                android:textSize="@dimen/tx_curfuel_size"
                android:textColor="@android:color/white"
                android:id="@+id/psa_tv_warn_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ListView
            android:id="@+id/psa_list_warn_info"
            android:layout_width="match_parent"
            android:layout_height="@dimen/psa_warn_height"
            android:layout_marginTop="@dimen/dps_psa_margintop"
            android:listSelector="#00000000"/>
    </LinearLayout>
</FrameLayout>
