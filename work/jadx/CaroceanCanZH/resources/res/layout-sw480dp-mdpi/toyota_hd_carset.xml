<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/fragment_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_tpyota_radar_set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/btn_toyota_otherset_radarvol_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_otherset_radarvol"
                    style="@style/car_info_style"/>
                <TextView style="@style/car_set_right_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/btn_toyota_fradar_dis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_fradar_dis"
                    style="@style/car_info_style"/>
                <TextView style="@style/car_set_right_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/btn_toyota_rradar_dis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_rradar_dis"
                    style="@style/car_info_style"/>
                <TextView style="@style/car_set_right_style1"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_toyota_other"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/layout_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset"
                    style="@style/car_info_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_speedautolock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_speedautolock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_linkageautolock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_linkageautolock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_smartcarlock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_smartcarlock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_blocklinkunlock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_blocklinkunlock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_unlockthekey"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_unlockthekey_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_responselock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_responselock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_2presslock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_2presslock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_drivinglinkunlock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_lockset_drivinglinkunlock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lockset_smartdoorunlock"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_smartdoorunlock_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lightset"
                    style="@style/car_info_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lightset_headlampssensitivity"
                    style="@style/car_info_style"/>
                <TextView style="@style/car_set_right_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/layout_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_lightset_setcarlightofftime"
                    style="@style/car_info_style"/>
                <TextView style="@style/car_set_right_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_airset"
                    style="@style/car_info_style1"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_airset_autolinkage"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_airset_autolinkage_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/layout_15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/str_tx_carset_airset_inoutgasautolinkage"
                    style="@style/car_info_style"/>
                <CheckBox
                    android:id="@+id/checkbox_toyota_airset_inoutgasautolinkage_onoff"
                    style="@style/car_set_checkbox"/>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
