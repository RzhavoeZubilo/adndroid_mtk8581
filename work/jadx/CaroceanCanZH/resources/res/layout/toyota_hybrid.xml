<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/layout_hybrid_dev"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/tx_curfuel_size"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_tx_hybrid_nodev"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/layout_hybrid_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:background="@drawable/toyota_hybrid_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/toyota_hybrid_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/toyota_hybrid_1"
                android:src="@drawable/toyota_hybrid_battery_0"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/toyota_hybrid_grend_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/toyota_hybrid_3"
                android:layout_marginRight="@dimen/toyota_hybrid_2"
                android:src="@drawable/toyota_hybrid_grend_right"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/toyota_hybrid_grend_left"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/toyota_hybrid_3"
                android:layout_marginRight="@dimen/toyota_hybrid_2"
                android:src="@drawable/toyota_hybrid_grend_left"
                android:contentDescription="@null"/>
            <ImageView
                android:id="@+id/toyota_hybrid_grend_ver"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/toyota_hybrid_4"
                android:layout_marginTop="@dimen/toyota_hybrid_5"
                android:src="@drawable/toyota_hybrid_grend_v"
                android:scaleType="center"
                android:contentDescription="@null"/>
            <ImageView
                android:id="@+id/toyota_hybrid_red_v"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/toyota_hybrid_6"
                android:layout_marginTop="@dimen/toyota_hybrid_7"
                android:src="@drawable/toyota_hybrid_red_v"
                android:scaleType="center"
                android:contentDescription="@null"/>
            <ImageView
                android:id="@+id/toyota_hybrid_red_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/toyota_hybrid_8"
                android:layout_marginTop="@dimen/toyota_hybrid_9"
                android:src="@drawable/toyota_hybrid_red_right"
                android:scaleType="center"
                android:contentDescription="@null"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
