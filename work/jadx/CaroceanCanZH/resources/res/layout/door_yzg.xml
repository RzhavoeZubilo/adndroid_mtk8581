<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ci_car"
            android:contentDescription="@string/app_name"/>
        <ImageView
            android:layout_gravity="top|left"
            android:id="@+id/iv_left_front_door"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ci_left_front_door_yzg"
            android:contentDescription="@string/app_name"/>
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/iv_right_front_door"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ci_right_front_door_yzg"
            android:contentDescription="@string/app_name"/>
        <ImageView
            android:layout_gravity="bottom|left"
            android:id="@+id/iv_left_back_door"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ci_left_back_door_yzg"
            android:contentDescription="@string/app_name"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/iv_right_back_door"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ci_right_back_door_yzg"
            android:contentDescription="@string/app_name"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/iv_rear_door_open"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ci_rear_door_open_yzg"
            android:contentDescription="@string/app_name"/>
    </FrameLayout>
</RelativeLayout>
