<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/fragment_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_joyear_carset_domedelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_joyear_domedelay"
                style="@style/car_info_style"/>
            <TextView style="@style/car_set_right_style1"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_joyear_carset_savingtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_joyear_savingtime"
                style="@style/car_info_style"/>
            <TextView style="@style/car_set_right_style1"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_joyear_speedlock"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_joyear_carset_speedlock_onoff"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/str_joyear_autolock"
                style="@style/car_info_style"/>
            <CheckBox
                android:id="@+id/checkbox_joyear_carset_autolock_onoff"
                style="@style/car_set_checkbox"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
