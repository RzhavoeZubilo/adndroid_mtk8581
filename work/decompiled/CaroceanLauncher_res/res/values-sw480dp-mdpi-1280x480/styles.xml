<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ClingText">
        <item name="android:textSize">22.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDy">2.0</item>
        <item name="android:shadowRadius">2.0</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="ClingTitleText">
        <item name="android:textSize">30.0sp</item>
        <item name="android:textColor">#33b5e5</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">5.0dp</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDy">2.0</item>
        <item name="android:shadowRadius">2.0</item>
    </style>
    <style name="DropTargetButton">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:paddingLeft">@dimen/toolbar_button_horizontal_padding</item>
        <item name="android:paddingTop">@dimen/toolbar_button_vertical_padding</item>
        <item name="android:paddingRight">@dimen/toolbar_button_horizontal_padding</item>
        <item name="android:paddingBottom">@dimen/toolbar_button_vertical_padding</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:shadowColor">#dd000000</item>
        <item name="android:shadowDx">0.0</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">4.0</item>
    </style>
    <style name="MainIconText">
        <item name="android:textSize">@dimen/workspace_icon_text_size</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center|bottom</item>
        <item name="android:maxLines">2</item>
        <item name="android:drawablePadding">10.0dp</item>
    </style>
    <style name="TabIndicator.AppsCustomize" parent="@style/TabIndicator">
        <item name="android:maxWidth">200.0dp</item>
    </style>
</resources>
