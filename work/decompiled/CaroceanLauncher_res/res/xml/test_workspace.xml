<?xml version="1.0" encoding="utf-8"?>
<favorites
  xmlns:launcher="http://schemas.android.com/apk/res/com.yecon.launcher1">
    <clock launcher:screen="0" launcher:x="0" launcher:y="0" />
    <search launcher:screen="1" launcher:x="0" launcher:y="0" />
    <folder launcher:screen="1" launcher:title="@string/folder_name" launcher:x="0" launcher:y="3">
        <favorite launcher:className="com.android.settings.Settings" launcher:packageName="com.android.settings" />
    </folder>
    <shortcut launcher:icon="@drawable/ic_allapps_pressed" launcher:screen="1" launcher:title="@string/home" launcher:uri="ACTION_ACCESSIBILITY_SETTINGS" launcher:x="1" launcher:y="0" />
    <appwidget launcher:className="com.mediatek.appwidget.weather.WeatherWidgetProvider" launcher:packageName="com.mediatek.appwidget.weather" launcher:screen="4" launcher:spanX="4" launcher:spanY="4" launcher:x="0" launcher:y="0" />
    <favorite launcher:className="com.android.contacts.activities.DialtactsActivity" launcher:container="-101" launcher:packageName="com.android.contacts" launcher:screen="0" launcher:x="0" launcher:y="0" />
    <favorite launcher:className="com.android.contacts.activities.PeopleActivity" launcher:container="-101" launcher:packageName="com.android.contacts" launcher:screen="1" launcher:x="1" launcher:y="0" />
    <favorite launcher:className="com.android.mms.ui.BootActivity" launcher:container="-101" launcher:packageName="com.android.mms" launcher:screen="3" launcher:x="3" launcher:y="0" />
    <favorite launcher:className="com.android.browser.BrowserActivity" launcher:container="-101" launcher:packageName="com.android.browser" launcher:screen="4" launcher:x="4" launcher:y="0" />
</favorites>
