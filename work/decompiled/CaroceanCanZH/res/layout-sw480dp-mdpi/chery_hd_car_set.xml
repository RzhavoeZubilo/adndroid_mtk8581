<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:orientation="vertical" android:background="@drawable/can_bg" android:padding="@dimen/fragment_padding" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="@string/chery_car_info" style="@style/car_info_style1" />
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_egen_brake_alram" style="@style/car_info_style" />
            <CheckBox android:id="@id/chery_checkbox_egen_brake_alram" style="@style/car_set_checkbox" />
        </RelativeLayout>
        <RelativeLayout android:layout_gravity="center_vertical" android:id="@id/chery_egen_braking_alram" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_egen_braking_alram" style="@style/car_info_style" />
            <TextView style="@style/car_info_right_style" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_auto_lock" style="@style/car_info_style" />
            <CheckBox android:id="@id/chery_checkbox_auto_lock" style="@style/car_set_checkbox" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_headlamp_delay" style="@style/car_info_style" />
            <CheckBox android:id="@id/chery_checkbox_headlamp_delay" style="@style/car_set_checkbox" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_daytime_lights" style="@style/car_info_style" />
            <CheckBox android:id="@id/chery_checkbox_daytime_lights" style="@style/car_set_checkbox" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_steering_avm" style="@style/car_info_style" />
            <CheckBox android:id="@id/chery_checkbox_steering_avm" style="@style/car_set_checkbox" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_steering_anim" style="@style/car_info_style" />
            <CheckBox android:id="@id/chery_checkbox_steering_anim" style="@style/car_set_checkbox" />
        </RelativeLayout>
        <RelativeLayout android:id="@id/chery_rl_vehicle_line" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_vehicle_line" style="@style/car_info_style" />
            <TextView style="@style/car_info_right_style" />
        </RelativeLayout>
        <RelativeLayout android:id="@id/chery_rl_speeding_alram" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_speeding_alram" style="@style/car_info_style" />
            <TextView style="@style/car_info_right_style" />
        </RelativeLayout>
        <RelativeLayout android:id="@id/chery_rl_dash_bklight" android:layout_width="wrap_content" android:layout_height="wrap_content">
            <TextView android:text="@string/chery_dash_bklight" style="@style/car_info_style" />
            <TextView style="@style/car_info_right_style" />
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
