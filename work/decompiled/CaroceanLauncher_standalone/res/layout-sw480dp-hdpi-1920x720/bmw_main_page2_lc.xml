<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0">
        <FrameLayout android:layout_gravity="center|bottom" android:id="@id/main_carinfo" android:background="@drawable/bmw_main_lc_carinfo" android:layout_width="@dimen/main_page_icon_width" android:layout_height="wrap_content">
            <TextView android:text="@string/home_carinfo_lc" style="@style/bmw_main_page_icon_title" />
            <com.android.launcher2.popuView.MarqueeTextView android:text="@string/home_carinfo_text" style="@style/bmw_main_page_icon_text" />
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0">
        <FrameLayout android:layout_gravity="center|bottom" android:id="@id/main_app" android:background="@drawable/bmw_main_lc_app" android:layout_width="@dimen/main_page_icon_width" android:layout_height="wrap_content">
            <TextView android:text="@string/home_app_lc" style="@style/bmw_main_page_icon_title" />
            <com.android.launcher2.popuView.MarqueeTextView android:text="@string/home_app_text" style="@style/bmw_main_page_icon_text" />
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0">
        <FrameLayout android:layout_gravity="center|bottom" android:id="@id/main_phonelink" android:background="@drawable/bmw_main_lc_phonelink" android:layout_width="@dimen/main_page_icon_width" android:layout_height="wrap_content">
            <TextView android:id="@id/main_phonelink_title" android:text="@string/home_phonelink" style="@style/bmw_main_page_icon_title" />
            <com.android.launcher2.popuView.MarqueeTextView android:text="@string/home_phonelink_text" style="@style/bmw_main_page_icon_text" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
