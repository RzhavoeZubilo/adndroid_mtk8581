<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <stroke android:width="4.0dp" android:color="@android:color/transparent" />
            <size android:height="24.0dp" android:width="24.0dp" />
        </shape>
    </item>
    <item>
        <shape android:tint="#bdbdbd" android:shape="oval">
            <solid android:color="@color/white" />
            <stroke android:width="4.0dp" android:color="@android:color/transparent" />
            <size android:height="24.0dp" android:width="24.0dp" />
        </shape>
    </item>
</selector>
