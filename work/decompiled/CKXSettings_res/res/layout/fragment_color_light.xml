                <FrameLayout style="@style/main_item_style">
                    <TextView android:layout_gravity="start|center" android:text="@string/colorful_custom" style="@style/text_style" />
                </FrameLayout>
                <FrameLayout style="@style/main_item_style">
                    <LinearLayout android:layout_gravity="center" android:orientation="horizontal" android:paddingTop="@dimen/item_margin_top_reverse" android:paddingRight="@dimen/color_block_margin" android:paddingBottom="@dimen/item_margin_top_reverse" android:layout_width="wrap_content" android:layout_height="wrap_content" android:baselineAligned="false">
                        <TextView android:id="@id/light_red" android:background="@drawable/rb_red_style" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/color_block_margin" />
                        <TextView android:id="@id/light_orange" android:background="@drawable/rb_orange_style" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/color_block_margin" />
                        <TextView android:id="@id/light_yellow" android:background="@drawable/rb_yellow_style" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/color_block_margin" />
                        <TextView android:id="@id/light_green" android:background="@drawable/rb_green_style" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/color_block_margin" />
                        <TextView android:id="@id/light_blue" android:background="@drawable/rb_blue_style" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:layout_marginStart="@dimen/color_block_margin" />
