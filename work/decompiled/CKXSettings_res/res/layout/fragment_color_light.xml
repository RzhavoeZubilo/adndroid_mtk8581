                <FrameLayout android:paddingTop="@dimen/color_block_margin" android:paddingBottom="@dimen/color_block_margin" style="@style/main_item_style">
                    <TextView android:textSize="@dimen/text_size_medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R" android:layout_marginStart="45.0dp" />
