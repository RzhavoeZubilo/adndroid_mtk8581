                </FrameLayout>
                <FrameLayout android:paddingTop="@dimen/color_block_margin" android:paddingBottom="@dimen/color_block_margin" style="@style/main_item_style">
                    <TextView android:textSize="@dimen/text_size_medium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B" android:layout_marginStart="45.0dp" />
                    <SeekBar android:id="@id/seekbar_b" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:progressDrawable="@drawable/seekbar_style_blue" android:thumb="@drawable/ic_sys_seekbar_thumb_night" android:thumbOffset="0.0dp" android:layout_marginStart="65.0dp" android:layout_marginEnd="25.0dp" android:min="0" />
