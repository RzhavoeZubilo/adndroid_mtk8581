<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/title_volume">
        <com.carocean.settings.ui.SettingsSeekBarPreference app:key="media_volume" app:title="@string/media_volume" />
        <com.carocean.settings.ui.SettingsSeekBarPreference app:isPreferenceVisible="false" app:key="navi_volume" app:title="@string/navi_volume" />
        <com.carocean.settings.ui.SettingsSeekBarPreference app:key="bt_volume" app:title="@string/bt_volume" />
        <com.carocean.settings.ui.SettingsSeekBarPreference android:max="100" app:key="gps_mixing" app:min="0" app:title="@string/gps_mixing" />
    </PreferenceCategory>
</PreferenceScreen>
