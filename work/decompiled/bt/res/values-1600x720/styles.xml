<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="NobackDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="bmw_id8_left_btn">
        <item name="android:textSize">22.0sp</item>
        <item name="android:textColor">@color/bmw_id8_orange_left_btn_text_color_selector</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@drawable/bmw_id8_orange_left_btn_bg</item>
        <item name="android:paddingLeft">5.0dp</item>
        <item name="android:paddingTop">5.0dp</item>
        <item name="android:paddingRight">5.0dp</item>
        <item name="android:paddingBottom">5.0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">70.0dp</item>
        <item name="android:layout_marginTop">2.0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">1.0</item>
        <item name="android:shadowDy">1.0</item>
        <item name="android:shadowRadius">0.6</item>
    </style>
    <style name="bmw_title_text">
        <item name="android:textSize">32.0sp</item>
        <item name="android:textColor">@color/text_normal</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="panel_button_text">
        <item name="android:textSize">28.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_normal</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="panel_input_text">
        <item name="android:textSize">40.0sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_normal</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
